{
  "name": "@gazepoint/sdk-web",
  "version": "2.0.0",
  "description": "Real-time eye tracking and gaze point detection for web browsers",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "webpack serve --mode development",
    "build": "webpack --mode production && tsc --declaration --emitDeclarationOnly --outDir dist",
    "test": "jest",
    "lint": "eslint src --ext .ts,.tsx",
    "example": "cd examples/basic && npx http-server -p 8080"
  },
  "keywords": [
    "eye-tracking",
    "gaze-detection",
    "computer-vision",
    "mediapipe",
    "tensorflow",
    "face-detection",
    "web",
    "webrtc",
    "webassembly"
  ],
  "author": "Tareq Abu Saleh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tareq-Ghassan/GazePointSDK-Web.git"
  },
  "bugs": {
    "url": "https://github.com/Tareq-Ghassan/GazePointSDK-Web/issues"
  },
  "homepage": "https://github.com/Tareq-Ghassan/GazePointSDK-Web#readme",
  "dependencies": {
    "@mediapipe/face_mesh": "^0.4.1633559619",
    "@mediapipe/camera_utils": "^0.3.1620248595",
    "@tensorflow/tfjs": "^4.11.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.5",
    "@types/node": "^20.8.0",
    "@typescript-eslint/eslint-plugin": "^6.7.5",
    "@typescript-eslint/parser": "^6.7.5",
    "eslint": "^8.51.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.0",
    "typescript": "^5.2.2",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
